NODE_ENV=development
BACKEND_PORT=3087
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://app_user:replace-me@localhost:5432/election_pollworker
JWT_SECRET=replace-with-at-least-32-random-characters
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
UPLOAD_DIR=./var/uploads
ENABLE_LEGACY_PROTOTYPE_ROUTES=false
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
